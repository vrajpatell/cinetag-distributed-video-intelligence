# Local open-source stack. Docker Compose already supplies these defaults;
# copy this file to .env only when you want to override them.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://cinetag:cinetag@postgres:5432/cinetag
REDIS_URL=redis://valkey:6379/0
QUEUE_BACKEND=celery
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/cinetag-store

# Local machine-learning providers: no API keys or usage fees.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
TRANSCRIPTION_PROVIDER=faster_whisper
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2:1.5b
OLLAMA_EMBEDDING_MODEL=all-minilm
VISION_PROVIDER=ollama
OLLAMA_VISION_MODEL=granite3.2-vision:2b
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# all-minilm produces 384 dimensions while the historical pgvector column is
# 1536 dimensions, so local mode uses the JSON/Python cosine-search fallback.
SEMANTIC_SEARCH_BACKEND=python
PGVECTOR_ENABLED=false

PROVIDER_STRICT=false
MEDIA_STRICT=false
AUTH_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
