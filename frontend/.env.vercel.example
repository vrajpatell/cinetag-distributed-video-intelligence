# Free Vercel showcase: serves bundled demo catalog/search/job/review data and
# disables video uploads. No external services, API keys, or paid providers.
NEXT_PUBLIC_DEMO_MODE=true

# Optional UI/deployment metadata.
NEXT_PUBLIC_APP_ENV=showcase
NEXT_PUBLIC_DEPLOY_PLATFORM=Vercel
NEXT_PUBLIC_DEPLOY_REGION=global

# Full-stack mode: set DEMO_MODE=false and point this at a separately hosted
# FastAPI control plane. Ollama and the long-running workers do not fit Vercel
# Functions; the repository's Docker Compose stack remains the zero-cost option.
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_API_BASE_URL=https://cinetag-api.example.com

# Never put API credentials in NEXT_PUBLIC_* variables. The current browser client
# is intended for a demo API protected by origin controls; production auth should
# use user sessions or a server-side backend-for-frontend.
